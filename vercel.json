{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "fusion_os/**",
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "/", "destination": "/dashboard", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
