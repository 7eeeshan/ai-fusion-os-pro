{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Fusion OS Pro",
  "version": "0.9.0",
  "identifier": "pro.aifusion.osdesktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Fusion OS Pro",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "AI Fusion",
    "shortDescription": "Governed AI workforce for your PC",
    "longDescription": "AI Fusion OS Pro: missions, agents, skills, research and security operations, governed by approvals, policies and an audit log. Runs without Docker.",
    "category": "Productivity",
    "copyright": "AI Fusion",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../build/backend/": "backend/",
      "../../build/tor/": "tor/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerHooks": "installer/hooks.nsh"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp",
        "upgradeCode": "6f1c3b8e-2a4d-4f6b-9a51-7d2e8c0f4a13"
      }
    }
  },
  "plugins": {}
}
